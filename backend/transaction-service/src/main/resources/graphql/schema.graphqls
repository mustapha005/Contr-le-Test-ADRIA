type BankTransaction {
  id: ID!, accountId: ID!, targetAccountId: ID, amount: String!, currency: String!, merchantCategory: String!, country: String!, createdAt: String!
}
input CreateTransactionInput { accountId: ID!, amount: String!, currency: String!, merchantCategory: String!, country: String! }
input TransferInput { sourceAccountId: ID!, targetAccountId: ID!, amount: String!, currency: String! }
type Query { transactions(accountId: ID): [BankTransaction!]!, transaction(id: ID!): BankTransaction }
type Mutation { createTransaction(input: CreateTransactionInput!): BankTransaction!, transfer(input: TransferInput!): BankTransaction! }
